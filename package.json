{
  "name": "tlm-gulp",
  "version": "1.0.0",
  "description": "sborka gulp",
  "main": "gulpfile.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/js/app.js\" \"src/js/modules/**/*.js\" \"src/scss/**/*.scss\"",
    "format:check": "prettier --check \"src/js/app.js\" \"src/js/modules/**/*.js\" \"src/scss/**/*.scss\"",
    "test": "node --test tests/*.test.js",
    "dev": "gulp",
    "build": "gulp build --build",
    "zip": "gulp deployZIP --build",
    "deploy": "npm run build && git add . && git commit -m \"commit\" && git push",
    "ftp": "npm run build && node .vscode/ftp-deploy-config.js"
  },
  "author": "Liana",
  "license": "ISC",
  "devDependencies": {
    "browser-sync": "^2.27.7",
    "del": "^6.0.0",
    "ftp-deploy": "^2.4.7",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-cli": "^2.3.0",
    "gulp-file-include": "^2.3.0",
    "gulp-fonter": "^0.3.0",
    "gulp-html-beautify": "^1.0.1",
    "gulp-if": "^3.0.0",
    "gulp-newer": "^1.4.0",
    "gulp-notify": "^4.0.0",
    "gulp-plumber": "^1.2.1",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.3",
    "gulp-sass": "^5.1.0",
    "gulp-shorthand": "^1.1.0",
    "gulp-ttf2woff2": "^4.0.1",
    "gulp-version-number": "^0.2.4",
    "gulp-zip": "^5.1.0",
    "prettier": "3.9.10",
    "sass": "^1.45.2",
    "vinyl": "^2.2.1",
    "webpack": "^5.65.0",
    "webpack-stream": "^7.0.0"
  },
  "dependencies": {
    "@fancyapps/ui": "^5.0.36",
    "swiper": "^11.2.1"
  }
}
