{
  "name": "tlm-gulp",
  "version": "1.0.0",
  "description": "sborka gulp",
  "main": "gulpfile.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/js/app.js\" \"scripts/html-format.js\" \"scripts/prettier-plugin.js\" \"src/scss/**/*.scss\" && node scripts/html-format.js --write",
    "format:check": "prettier --check \"src/js/app.js\" \"scripts/html-format.js\" \"scripts/prettier-plugin.js\" \"src/scss/**/*.scss\" && node scripts/html-format.js --check",
    "test": "node --test tests/*.test.js",
    "dev": "gulp",
    "build": "gulp build --build",
    "zip": "gulp deployZIP --build",
    "deploy": "npm run build && git add . && git commit -m \"commit\" && git push",
    "ftp": "npm run build && node .vscode/ftp-deploy-config.js",
    "validate:html": "node scripts/validate-html.js",
    "test:browser": "playwright test tests/browser/refactor.spec.js tests/browser/regressions.spec.js tests/browser/html-content.spec.js tests/browser/markup-refactor.spec.js tests/browser/unified-forms.spec.js tests/browser/checkout-controls.spec.js tests/browser/comparison-polish.spec.js tests/browser/pagination.spec.js tests/browser/validation-only.spec.js"
  },
  "author": "Liana",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "browser-sync": "^2.27.7",
    "del": "^6.0.0",
    "ftp-deploy": "^2.4.7",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-cli": "^2.3.0",
    "gulp-file-include": "^2.3.0",
    "gulp-fonter": "^0.3.0",
    "gulp-html-beautify": "^1.0.1",
    "js-beautify": "1.15.1",
    "gulp-if": "^3.0.0",
    "gulp-newer": "^1.4.0",
    "gulp-notify": "^4.0.0",
    "gulp-plumber": "^1.2.1",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.3",
    "gulp-sass": "^5.1.0",
    "gulp-shorthand": "^1.1.0",
    "gulp-ttf2woff2": "^4.0.1",
    "gulp-version-number": "^0.2.4",
    "gulp-zip": "^5.1.0",
    "html-validate": "^11.17.0",
    "prettier": "3.9.10",
    "sass": "^1.45.2",
    "vinyl": "^2.2.1"
  },
  "dependencies": {
    "@fancyapps/ui": "^5.0.36",
    "swiper": "^11.2.1"
  }
}
