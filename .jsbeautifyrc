{
    "html": {
        "indent_size": 4,
        "indent_with_tabs": false,
        "indent_inner_html": true,
        "wrap_line_length": 0,
        "wrap_attributes": "auto",
        "extra_liners": [],
        "unformatted": [],
        "inline": [],
        "inline_custom_elements": false,
        "content_unformatted": ["pre", "textarea"],
        "preserve_newlines": true,
        "max_preserve_newlines": 1,
        "end_with_newline": true,
        "eol": "\n"
    }
}
